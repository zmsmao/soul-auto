<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/bg_page_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_toolbar" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_horizontal_padding"
                android:paddingTop="@dimen/page_top_padding"
                android:paddingEnd="@dimen/page_horizontal_padding"
                android:paddingBottom="@dimen/page_bottom_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="聊天样本"
                    android:textAppearance="@style/TextAppearance.SoulBot.PageTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="只学习表达方式，不借用样本里其他人的个人信息。"
                    android:textAppearance="@style/TextAppearance.SoulBot.Supporting" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="@dimen/page_card_radius"
                    app:cardElevation="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="按照“对方：”“我：”的格式粘贴真实聊天。每组前可加“场景：聊天回复 / 灵魂匹配 / 奇遇铃 / 广场私聊”中的一种。未标注场景的旧样本默认作为聊天回复；开场的“对方”可填写资料或匹配提示。"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingExtra="3dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.SoulBot.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="聊天样本">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etStyleSamples"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:hint="场景：聊天回复\n对方：下班了吗\n我：刚下，累死了\n\n场景：灵魂匹配\n对方：喜欢做饭，不喜欢洗碗\n我：最烦吃饱以后还得面对一池子碗"
                                android:inputType="textMultiLine|textCapSentences"
                                android:maxLength="20000"
                                android:minHeight="200dp"
                                android:maxLines="14"
                                android:scrollbars="vertical" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportStyle"
                            style="@style/Widget.SoulBot.PrimaryButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="导入聊天样本" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="清理学习数据"
                    android:textAppearance="@style/TextAppearance.SoulBot.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="这些操作不会删除完整聊天记忆或 Soul 内的消息。"
                    android:textAppearance="@style/TextAppearance.SoulBot.Supporting" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearStyle"
                    style="@style/Widget.SoulBot.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="清除聊天风格样本" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearContactMemory"
                    style="@style/Widget.SoulBot.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="清除旧版联系人摘要" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>