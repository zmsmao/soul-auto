<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="66dp"
        app:cardBackgroundColor="@color/inbox_nav"
        app:cardCornerRadius="26dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:itemIconSize="20dp"
            app:itemIconTint="@color/nav_item_tint"
            app:itemTextColor="@color/nav_item_tint"
            app:itemRippleColor="@color/inbox_tab_ripple"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_primary_navigation" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCompose"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="end|center_vertical"
        android:contentDescription="打开 Soul"
        android:src="@drawable/ic_compose"
        app:backgroundTint="@color/inbox_nav"
        app:elevation="8dp"
        app:fabSize="normal"
        app:tint="@color/inbox_text" />
</FrameLayout>
